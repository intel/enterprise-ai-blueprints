###############################################################################
# Customer Support Agent — Configuration
#
# Local (Docker Compose) settings. Kubernetes deploys are configured through
# the repo-root config.env + deploy.sh, which auto-discover AI Solutions services.
###############################################################################

# --- LLM Configuration ---
# Base URL for the OpenAI-compatible LLM endpoint. On AI Solutions:
# https://litellm.<base_domain_name>/v1 (in-cluster: http://litellm.litellm.svc.cluster.local:4000/v1)
LLM_BASE_URL=

# API key for authenticating with the LLM endpoint
LLM_API_KEY=

# Model identifier to use for inference
LLM_MODEL=qwen2-5-coder-14b

# --- Long-term Memory (RediSearch vector store + LiteLLM embeddings) ---
# Set MEMORY_ENABLED=false to disable memory entirely. Memory is fail-open:
# if Redis or embeddings are unavailable the agent still runs without it.
MEMORY_ENABLED=true
REDIS_URL=redis://redis-stack-server.redis.svc.cluster.local:6379/0
MEMORY_INDEX=csa_mem_idx
MEMORY_TOP_K=4
EMBEDDING_MODEL=bge-base-en
EMBEDDING_DIMS=768

# --- Parallel Tool Execution ---
# TOOL_EXECUTOR: "local" (in-process thread pool) or "ray" (KubeRay dispatch).
TOOL_EXECUTOR=local
TOOL_MAX_PARALLEL=8
RAY_ADDRESS=ray://ray-cluster-head-svc.ray-system:10001
SELF_API_URL=http://localhost:8502

# --- Application Ports ---
# Port for the FastAPI backend server
API_PORT=8502

# Port for the Streamlit frontend UI
STREAMLIT_PORT=8501

# --- Database ---
# Path to the SQLite database file (the image defaults to /app/data/techgadgets.db)
# DB_PATH=/app/data/techgadgets.db
