###############################################################################
# Coding Agent — LangGraph Configuration
#
# Local (Docker Compose) settings. Kubernetes deploys are configured through
# the repo-root config.env + deploy.sh, which auto-discover AI Solutions services.
###############################################################################

# --- LLM Configuration ---
# OpenAI-compatible endpoint URL. On AI Solutions: https://litellm.<base_domain_name>/v1
# (in-cluster: http://litellm.litellm.svc.cluster.local:4000/v1)
OPENAI_BASE_URL=

# API key for authenticating with the LLM endpoint
OPENAI_API_KEY=

# Model identifier to use for inference
MODEL_NAME=qwen2-5-coder-14b

# --- Redis (persistent memory / checkpointing) ---
REDIS_URL=redis://localhost:6379

# --- Agent Sandbox (isolated code execution in Kubernetes) ---
SANDBOX_NAMESPACE=agent-sandbox-system
SANDBOX_TEMPLATE=python-sandbox-template
SANDBOX_ROUTER_URL=http://sandbox-router-svc.agent-sandbox-system.svc.cluster.local:8080
SANDBOX_WARMPOOL=python-pool
SANDBOX_ROUTER_TOKEN=

# --- Ray (distributed parallel execution, optional) ---
RAY_ENABLED=false
RAY_ADDRESS=

# --- Application Settings ---
DEVUI_PORT=8090
DEVUI_HOST=0.0.0.0
DEVUI_AUTH_TOKEN=
AUTO_OPEN_BROWSER=false

# --- Workspace ---
WORKSPACE_DIR=/app/workspace

# --- Langfuse Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=          # e.g. http://langfuse-web.langfuse.svc.cluster.local:3000
LANGFUSE_ENABLE_SENSITIVE_DATA=true
