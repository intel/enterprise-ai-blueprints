###############################################################################
# Unified Decision Gate — Configuration (Docker mode)
#
# Copy to .env (git-ignored) and fill in, or edit here, then
#   docker compose --env-file config/agent-config.env up -d --build --wait
# Kubernetes mode (deploy.sh) does not read this file: it takes its values from the
# environment, auto-discovers them, or prompts. Generate secrets with: openssl rand -hex 24
###############################################################################

# --- LiteLLM gateway (the agent's LLM) ----------------------------------------
# The agent calls the model through LiteLLM. Use this machine's IP, not
# localhost: the agent runs in a container. Export LITELLM_HOST=<that host> as
# well, so the agent's no_proxy bypasses the proxy for it.
LITELLM_URL=
LITELLM_API_KEY=
# Must be a tool-calling model registered on the gateway.
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# --- Access ---------------------------------------------------------------------
# REQUIRED. Clients send it as "Authorization: Bearer <token>"; the gate checks it
# and passes it through to the agent (DevUI refuses to start without one).
DEVUI_AUTH_TOKEN=

# --- System-1 model (Qwen3-0.6B on vLLM) ---------------------------------------
# System-1 is a structured-decisions model served by vLLM (docs.vllm.ai, "Structured
# Decisions Models"). The gate calls its POST /v1/systemone directly, not through LiteLLM:
# no gateway key, usage tracking or trace for System-1. Its own vLLM instance, next to the
# LLM's (one vLLM server serves one model), e.g.
#   vllm serve Qwen/Qwen3-0.6B --logprobs-mode raw_logprobs --enable-prefix-caching
#   - the vLLM must HAVE /v1/systemone: v0.32.0 does, 0.24.0 / 0.28.0 do not
#     (every read then fails with a 404 and the gate sends everything to the agent);
#   - --logprobs-mode raw_logprobs (or processed_logprobs) is required to read the labels;
#   - --enable-prefix-caching: recommended. With the action veto off (the default) the gate
#     asks one question per call; with the veto on it asks two over the same state, which is
#     then prefilled once.
# Scores are not deterministic: vLLM's probabilities shift with batch-mates and prefix-cache
# hits (Qwen3-0.6B: up to 0.0023 between identical one-at-a-time runs, 0.0225 between one at
# a time and 16 concurrent). VLLM_BATCH_INVARIANT=1 would fix it but is not supported on CPU,
# so fit the cut-offs at the target load.
# Monitoring: every call to the gate's /health makes a real /v1/systemone read, so a scraper
# polling it every few seconds adds load to this vLLM. Probes use /live, which never asks it.
# REQUIRED: that vLLM's base URL, without /v1. This machine's IP, not localhost.
SYSTEM1_URL=
# The model name as vLLM serves it.
SYSTEM1_MODEL=Qwen/Qwen3-0.6B
# The vLLM's --api-key, if it has one.
SYSTEM1_API_KEY=
# Escalate when vLLM's label_mass (the share of probability on the yes/no tokens) is
# below this; 0 = off. Unmeasured: fit it with the cut-offs. Not independent of vLLM's
# confidence, which is already the label's share x label_mass.
SYSTEM1_MIN_LABEL_MASS=0

# --- System-1 decision gate -------------------------------------------------------
# SYSTEM1_* settings configure the System-1 decision model the gate asks; GATE_* settings the gate
# itself (its code is src/decision_gate). These names are the gate's public settings interface, in
# Docker, Helm and the docs alike.
# Display cut-offs on System-1's P(yes): "Yes." at or above SYSTEM1_YES_MIN, "No." at
# or below SYSTEM1_NO_MAX, the agent in between. Fitted for Qwen3-0.6B on 200 labelled banking
# questions: the cut (0.9929) with an unsure band of +-0.0023 around it, the run-to-run noise of
# one request at a time, so an answer that can flip between identical requests goes to the
# agent. Under load the scores shift more (up to 0.0225 at 16 concurrent requests;
# VLLM_BATCH_INVARIANT=1 is not supported on CPU), and a band that wide would leave almost
# nothing to show. Refit for any other model, wording or load.
SYSTEM1_YES_MIN=0.9952
SYSTEM1_NO_MAX=0.9906
# The "is this a request to do something" veto: above it, the agent answers. 1.0 = off:
# Qwen3-0.6B scores P(action) ~1 on every question (no signal).
# While it is off the gate does not ask that question at all (one vLLM read saved per call);
# the capability-opener text rule ("Is it possible to block my card?") covers part of the gap.
SYSTEM1_MAX_P_ACTION=1.0
# true = log System-1's decision but always answer from the agent; false = show
# System-1's yes/no when it is sure. ON by default (as in Helm): the action veto is off
# and the cut-offs are fitted for the banking example. Turn it off only after measuring.
GATE_SHADOW_MODE=true
# false = System-1 is never asked; every question goes to the agent.
GATE_ENABLED=true
# HMAC key for question hashes in the decision log, so repeats stay linkable
# across restarts. Random per restart when empty.
GATE_TELEMETRY_HASH_KEY=
# Store the question text in the decision log (off: only its hash and length).
GATE_LOG_QUESTION_TEXT=false
# The text rules (regexes that send a question to the agent without asking System-1) are in
# src/decision_gate/text_rules.json; add yours there, or mount a file and point this at it.
# GATE_TEXT_RULES=/rules/my_text_rules.json
# X-Gate-* response headers (route, reason, scores). true to measure routing.
GATE_DEBUG_HEADERS=false

# --- Host ports ---------------------------------------------------------------------
# A platform Redis may already use 6379 on the same host.
REDIS_HOST_PORT=6380
