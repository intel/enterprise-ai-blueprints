###############################################################################
# AI Blueprints — Unified Deployment Configuration
# Target platform: Intel® AI for Enterprise Solutions release-1.2
#                  (agent-toolkit layer, enterprise-agent-toolkit release-2.0.0)
#
# Fill in the values below before running any deploy.sh script.
# This single file provides the environment variables used across the use cases:
#   - Coding Agent MAF
#   - Banking Assistant
#
# Usage:
#   1. Copy this file:  cp config.env config.local.env
#   2. Fill in your values in config.local.env
#   3. Load and deploy: set -a && source config.local.env && set +a
#                       ./deploy-usecase.sh <usecase-name>
#
# NOTE: Never commit config.local.env — it contains secrets.
###############################################################################

###############################################################################
# Platform
###############################################################################

# AI Solutions base_domain_name (env/<env>/global_config.yaml), e.g. solutions.ai.
# Blueprints are published as <usecase>.<CLUSTER_URL> on the eg-gateway.
# deploy.sh auto-discovers it from the eg-gateway listeners when left empty.
CLUSTER_URL=

# true = add the blueprint namespace to LiteLLM's Istio AuthorizationPolicy
# (litellm/litellm-ingress) directly. Temporary — the next AI Solutions install
# resets it; the permanent fix is litellm_allowed_namespaces in
# env/<env>/config.agent-toolkit.yaml.
PATCH_LITELLM_AUTHZ=false

###############################################################################
# LLM / Inference Endpoint (LiteLLM, from the AI Solutions inference layer)
###############################################################################

# OpenAI-compatible API base URL.
# In-cluster: http://litellm.litellm.svc.cluster.local:4000/v1
# External:   https://litellm.<base_domain_name>/v1   (Docker mode)
# (deploy.sh defaults to the in-cluster URL when left empty.)
OPENAI_BASE_URL=

# LiteLLM API key. Prefer a virtual key (POST /key/generate). When left empty,
# deploy.sh falls back to the master key in secret litellm/litellm-master-key.
OPENAI_API_KEY=

# Model id for inference — must support tool calling and match a model registered
# in LiteLLM (AI Solutions default: qwen2-5-coder-14b). deploy.sh prompts if empty.
MODEL_NAME=

###############################################################################
# Redis (memory / session state)
###############################################################################

# Authenticated Redis URL — the shared Redis requires a password
# (redis://default:<password>@...). deploy.sh auto-discovers it from the
# redis-stack-server-credentials secret when left empty.
REDIS_URL=

###############################################################################
# Coding Agent MAF — DevUI
###############################################################################

DEVUI_PORT=8090
DEVUI_HOST=0.0.0.0

# Authentication token for DevUI (auto-generated if left empty)
DEVUI_AUTH_TOKEN=

# Agent Sandbox (isolated code execution). The agent-toolkit layer installs it in
# the fixed namespace 'agent-sandbox-system' with the "python-pool" warm pool.
# deploy.sh auto-discovers SANDBOX_ROUTER_TOKEN from the sandbox-router-auth secret.
SANDBOX_NAMESPACE=agent-sandbox-system
SANDBOX_TEMPLATE=python-sandbox-template
SANDBOX_WARMPOOL=python-pool
# In-cluster: http://sandbox-router-svc.agent-sandbox-system.svc.cluster.local:8080
# (deploy.sh defaults to this when left empty.)
SANDBOX_ROUTER_URL=
SANDBOX_ROUTER_TOKEN=

###############################################################################
# Observability — Langfuse (Optional, both use cases)
###############################################################################

# deploy.sh auto-discovers the keys from secret langfuse/langfuse-secrets
# (public_key / secret_key) when both are left empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# In-cluster: http://langfuse-web.langfuse.svc.cluster.local:3000 (default when keys are set)
# UI:         https://langfuse.<base_domain_name>
LANGFUSE_HOST=
LANGFUSE_ENABLE_SENSITIVE_DATA=true

###############################################################################
# Workspace
###############################################################################

WORKSPACE_DIR=/app/workspace
AUTO_OPEN_BROWSER=false
